# Default OpenSSL CFLAGS
CFLAGS += -DOPENSSL_BN_ASM_MONT \
		-DAES_ASM \
		-DSHA1_ASM \
		-DSHA256_ASM \
		-DSHA512_ASM \
		-DNO_WINDOWS_BRAINDEATH \
		-DOPENSSL_IMPLEMENTS_strncasecmp \
		-DGETPID_IS_MEANINGLESS \
		-DOPENSSL_THREADS \
		-D_REENTRANT \
		-DDSO_DLFCN \
		-DHAVE_DLFCN_H \
		-DZLIB \
		-DL_ENDIAN

# Disable un-necessary crypto algos
CFLAGS += -DOPENSSL_NO_CAMELLIA \
		-DOPENSSL_NO_CAPIENG \
		-DOPENSSL_NO_CAST \
		-DOPENSSL_NO_CMS \
		-DOPENSSL_NO_STDIO \

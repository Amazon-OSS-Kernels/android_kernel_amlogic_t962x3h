		-DOPENSSL_NO_SEED \
		-DOPENSSL_NO_STORE \
		-DOPENSSL_NO_WHIRLPOOL \
		-DOPENSSL_NO_MD4 \
		-DOPENSSL_NO_MD5 \
		-DOPENSSL_NO_DES \
		-DOPENSSL_NO_OCSP \
		-DOPENSSL_NO_AES \
		-DOPENSSL_NO_DSA \

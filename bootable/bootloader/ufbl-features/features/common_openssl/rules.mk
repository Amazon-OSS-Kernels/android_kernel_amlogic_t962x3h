		-DOPENSSL_NO_EC2M \
		-DOPENSSL_NO_PKCS12 \
		-DOPENSSL_NO_EC \
		-DOPENSSL_NO_ECDSA

CFLAGS += -DOPENSSL_SYS_LK -DOPENSSL_NO_HMAC -DNO_STDERR -DNO_ABORT -DNO_TIME \

#Run make by either typing make openssl, or make libtomcrypt
#make help wil provide a help menu
#If the build directory does not exist, then make it and update size.h to have the correct image size
define MKDIR
	if [ ! -d $(dir $1) ]; \
		then \
			mkdir -p $(dir $1); \
		fi
endef

BUILDDIR :=out
TOPDIR          := ./
GET_LOCAL_DIR   = $(patsubst %/,%,$(dir $(word $(words $(MAKEFILE_LIST)),$(MAKEFILE_LIST))))
export TOPDIR GET_LOCAL_DIR
LOCAL_PATH := $(GET_LOCAL_DIR)
ROOTDIR :=$(patsubst  %/bootable/bootloader/ufbl-features/tests/signature_test_tool/regression_tests,%, $(abspath $(LOCAL_PATH)))
#Intialize the UFBL makefile variables
UFBL_ENABLE     := yes
UFBL_PROJECT    := signature_tests
UFBL_PATH       := $(ROOTDIR)/bootable/bootloader/ufbl-features
UFBL_LIB_PATH   := ufbl-features/features
export UFBL_ENABLE UFBL_PATH UFBL_LIB_PATH UFBL_PROJECT ROOTDIR MAKECMDGOALS
TARGET_BUILD_VARIANT := userdebug
LIBRARY_HOME    := ../lib

CFLAGS :=
OBJS :=
DEFINES := UFBL_SUPPORTS_WCSTOMBS

#Call the makefile of UFBL tree
ifeq (help,$(MAKECMDGOALS))
else ifeq (libtomcrypt,$(MAKECMDGOALS))
	include src/gtest_signature_rules_ltc.mk
	include $(UFBL_PATH)/build/ufbl.mk
else
	include src/gtest_signature_rules_openssl.mk
	include $(UFBL_PATH)/build/ufbl.mk
endif

LN_UFBL_LIBS := $(sort $(UFBL_LIBS))
ALLOBJS := $(OBJS)
ALLOBJS := $(addprefix $(BUILDDIR)/,$(ALLOBJS))

#Following for compiler warning for fsync
DEFINES += _POSIX_C_SOURCE=200809L

INCLUDES +=
CFLAGS += $(addprefix -D,$(DEFINES))
CFLAGS += --std=c99
CC = gcc



# A sample Makefile for building Google Test and using it in user
# tests.  Please tweak it to suit your environment and project.  You
# may want to move it to your project's root directory.
#
# SYNOPSIS:
#
#   make [all]  - makes everything.
#   make TARGET - makes the given target.
#   make clean  - removes all files generated by make.

# Please tweak the following variable definitions as needed by your
# project, except GTEST_HEADERS, which you can use in your own targets
# but shouldn't modify.

# Points to the root of Google Test, relative to where this file is.
# Remember to tweak this if you move this file.
GTEST_DIR = ../../../../../../external/gtest

# Where to find user code.
USER_DIR = ./

# Flags passed to the preprocessor.
# Set Google Test's header directory as a system directory, such that
# the compiler doesn't generate warnings in Google Test headers.
CPPFLAGS += -isystem $(GTEST_DIR)/include

# Flags passed to the C++ compiler.
CXXFLAGS += -g -Wall -Wextra -pthread

# All tests produced by this Makefile.  Remember to add new tests you
# created to the list.
TESTS = test

# All Google Test headers.  Usually you shouldn't change this
# definition.
GTEST_HEADERS = $(GTEST_DIR)/include/gtest/*.h \
                $(GTEST_DIR)/include/gtest/internal/*.h

# House-keeping build targets.

all : $(BUILDDIR)/$(TESTS)
	@echo "Please specify either make openssl or make libtomcrypt"
	@echo "make without any additional arguments will default to openssl"

openssl: $(BUILDDIR)/$(TESTS)

libtomcrypt: $(BUILDDIR)/$(TESTS)

help:
	@echo "Make this tool by either entering 'make openssl' or 'make libtomcrypt'"
	@echo "If a target isn't specified after 'make' it will default to openssl"
	@echo "To clean enter 'make clean' "

clean :
	@rm -rf $(BUILDDIR)
	@echo "Successfully cleaned"

# Builds gtest.a and gtest_main.a.

# Usually you shouldn't tweak such internal variables, indicated by a
# trailing _.
GTEST_SRCS_ = $(GTEST_DIR)/src/*.cc $(GTEST_DIR)/src/*.h $(GTEST_HEADERS)

# For simplicity and to avoid depending on Google Test's
# implementation details, the dependencies specified below are
# conservative and not optimized.  This is fine as Google Test
# compiles fast and for ordinary users its source rarely changes.
$(BUILDDIR)/gtest-all.o : $(GTEST_SRCS_)
	@$(call MKDIR,$@)
	@$(CXX) $(CPPFLAGS) -I$(GTEST_DIR) $(CXXFLAGS) -c \
            $(GTEST_DIR)/src/gtest-all.cc -o $(BUILDDIR)/gtest-all.o

$(BUILDDIR)/gtest_main.o : $(GTEST_SRCS_)
	@$(MKDIR)
	@$(CXX) $(CPPFLAGS) -I$(GTEST_DIR) $(CXXFLAGS) -c \
            $(GTEST_DIR)/src/gtest_main.cc -o $(BUILDDIR)/gtest_main.o

gtest.a : $(BUILDDIR)/gtest-all.o
	@$(call MKDIR,$@)
	@$(AR) $(ARFLAGS) $@ $^

$(BUILDDIR)/gtest_main.a : $(BUILDDIR)/gtest-all.o $(BUILDDIR)/gtest_main.o
	@$(call MKDIR,$@)
	@$(AR) $(ARFLAGS) $@ $^

# Builds a test.  A test should link with either gtest.a or
# gtest_main.a, depending on whether it defines its own main()
# function.

$(LIBRARY_HOME)/libtomcrypt.a:
	. ../lib/make_libtomcrypt.sh

$(LIBRARY_HOME)/libtommath.a:
	. ../lib/make_libtommath.sh

$(BUILDDIR)/%.o: %.cc $(LIBRARY_HOME)/libtomcrypt.a $(LIBRARY_HOME)/libtommath.a
	@$(call MKDIR,$@)
	@echo compiling $<
	@$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(INCLUDES) -c $< -o $@ $(LIBRARIES)

$(BUILDDIR)/%.o: %.c
	@$(call MKDIR,$@)
	@$(call MAKE_LIBTOMCRYPT)
	@$(call MAKE_LIBTOMMATH)
	@echo compiling $<
	@$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@ $(LIBRARIES)

$(BUILDDIR)/test : $(ALLOBJS) $(BUILDDIR)/gtest_main.a
	@$(call MKDIR,$@)
	@$(CXX) $(CPPFLAGS) $(CXXFLAGS) -lpthread $^ -o $@ $(LIBRARIES)
	@echo "Make successful"
